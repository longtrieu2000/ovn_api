# Network binding
OVN_CPU_HOST=0.0.0.0
OVN_CPU_PORT=8002

# Procfs source
# Run on host: keep /proc
# Run in container with host proc mounted: change to /host/proc
OVN_CPU_PROC_ROOT=/proc

# Sampling and retention
OVN_CPU_SAMPLE_INTERVAL_S=1.0
OVN_CPU_HISTORY_SIZE=900
OVN_CPU_HISTORY_LIMIT=120
OVN_CPU_TOP_THREADS=20
OVN_CPU_THREADS_PER_COMPONENT=5

# Include kernel datapath-adjacent threads such as ksoftirqd/irq/napi
OVN_CPU_ENABLE_KERNEL_THREADS=true

# Softirq counters to expose as deltas between samples
OVN_CPU_SOFTIRQS=NET_RX,NET_TX,RCU,TIMER,SCHED,HRTIMER

# Process names to track from procfs
OVN_CPU_PROCESS_NAMES=ovs-vswitchd,ovsdb-server,ovn-controller,ovn-controller-vtep,ovn-northd

# Example for containerized ovn_cpu:
# OVN_CPU_PROC_ROOT=/host/proc
